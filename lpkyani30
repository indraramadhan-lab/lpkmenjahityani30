  p{ margin:0 0 1em; color:var(--ink-soft); }
  a{ color:inherit; }
  img,svg{ display:block; max-width:100%; }
  img{ width:100%; height:100%; object-fit:cover; }
  ul{ margin:0; padding:0; list-style:none; }
  button{ font-family:inherit; cursor:pointer; }

  .container{ width:min(1180px, 92%); margin-inline:auto; }
  .section{ padding: clamp(64px,9vw,120px) 0; position:relative; }
  .section-alt{ background:var(--canvas-alt); }

  .skip-link{
    position:absolute; left:-999px; top:0; background:var(--ink); color:var(--kunyit);
    padding:.8em 1.2em; z-index:999; border-radius:0 0 10px 0;
  }
  .skip-link:focus{ left:0; }

  /* Eyebrow "hangtag" label — echoes garment care tags */
  .eyebrow{
    position:relative;
    display:inline-flex;
    align-items:center;
    gap:.55rem;
    padding:.5rem 1.1rem .5rem 1.7rem;
    margin-bottom:1.4rem;
    background:var(--ink);
    color:var(--kunyit);
    font-family:'DM Mono', monospace;
    font-size:.72rem;
    font-weight:500;
    letter-spacing:.14em;
    text-transform:uppercase;
    clip-path: polygon(14px 0, 100% 0, 100% 100%, 14px 100%, 0 50%);
  }
  .eyebrow::before{
    content:'';
    position:absolute; left:7px; top:50%; transform:translateY(-50%);
    width:5px; height:5px; border-radius:50%;
    background:var(--kunyit);
  }
  .eyebrow.light{ background:var(--kunyit); color:var(--ink); }
  .eyebrow.light::before{ background:var(--ink); }
  .eyebrow.onphoto{ background:rgba(255,251,242,.94); color:var(--ink); }
  .eyebrow.onphoto::before{ background:var(--terracotta); }

  /* Stitch divider — signature motif: hand-drawn dashed seam that sews itself in on scroll */
  .stitch-divider{ width:100%; height:34px; overflow:visible; margin: 6px 0; }
  .stitch-divider path{
    fill:none; stroke:var(--terracotta); stroke-width:2.4; stroke-linecap:round;
    stroke-dasharray: 9 11;
    stroke-dashoffset: 1400;
    transition: stroke-dashoffset 1.8s var(--ease);
  }
  .stitch-divider.in-view path{ stroke-dashoffset: 0; }

  .reveal{ opacity:0; transform: translateY(28px); transition: opacity .8s var(--ease), transform .8s var(--ease); }
  .reveal.in-view{ opacity:1; transform:none; }

  /* Buttons */
