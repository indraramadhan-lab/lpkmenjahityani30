    nav.primary-nav.open{ transform:translateY(0); opacity:1; visibility:visible; }
    nav.primary-nav ul{ flex-direction:column; align-items:stretch; gap:.15rem; }
    nav.primary-nav a{ font-size:1rem; padding:.65rem 0; display:block; border-bottom:1px solid var(--line); }
    nav.primary-nav li:last-child a{ border-bottom:none; }
    .menu-toggle{ display:block; }
    .nav-actions .btn-primary{ display:none; }
  }

  @media (max-width: 380px){
    .brand-name{ font-size:.92rem; }
    .brand-name span{ font-size:.56rem; }
  }

  /* ===== Hero (full-bleed photo) ===== */
  .hero{
