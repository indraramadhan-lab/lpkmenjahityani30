  .hero-inner{ position:relative; z-index:2; text-align:center; margin-inline:auto; max-width:820px; }
  .hero-inner h1{ color:#fff; font-size: clamp(2.1rem, 4.4vw, 3.4rem); }
  .hero-slogan{
    font-family:'Fraunces',serif; font-style:italic; color:var(--kunyit-pale);
    font-size:clamp(1.15rem,2.1vw,1.5rem); max-width:38ch; margin:0 auto 1.1rem; line-height:1.4;
  }
  .hero-lede{ color:#EFE6D6; max-width:56ch; margin:0 auto 2rem; font-size:1.03rem; }
  .hero-ctas{ display:flex; flex-wrap:wrap; gap:1rem; justify-content:center; margin-bottom: 3rem; }

  .stat-strip{
    position:relative; z-index:2; margin-top:auto; display:flex; justify-content:center; gap:0;
