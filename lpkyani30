  .brand-name span{ display:block; font-family:'DM Mono', monospace; font-size:.62rem; letter-spacing:.15em; color:var(--terracotta-deep); font-weight:500; }

  nav.primary-nav ul{ display:flex; gap:1.9rem; align-items:center; }
