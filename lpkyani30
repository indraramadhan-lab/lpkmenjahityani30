  .program-card.wirausaha .program-icon-wrap{ background:#FFE0CC; }

  /* ===== Fasilitas ===== */
  .facility-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:1.6rem; }
  .facility-card{ background:var(--card); border-radius:var(--radius-md); overflow:hidden; border:1px solid var(--line); transition:transform .3s var(--ease), box-shadow .3s var(--ease); }
  .facility-card:hover{ transform:translateY(-5px); box-shadow:var(--shadow); }
  .facility-photo{ aspect-ratio:4/3; overflow:hidden; }
